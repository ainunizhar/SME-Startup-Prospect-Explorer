table Companies
	lineageTag: 2df2506d-c0b3-5923-8de8-c9c5bd63ab42

	measure Companies = COUNTROWS ( Companies )
		formatString: #,0
		lineageTag: 7ffc4345-c786-564d-916c-0f601b846388

	measure 'Funded Companies' = CALCULATE ( [Companies], Companies[Has Funding] = "Yes" )
		formatString: #,0
		lineageTag: 1297b2ed-d810-5fda-9ff7-fadda3e6b67a

	measure 'Total Funding ($M)' = DIVIDE ( SUM ( Companies[Total Funding USD] ), 1000000 )
		formatString: #,0.0
		lineageTag: 58d72517-1006-55aa-a202-29ef60c76356

	measure 'Median Funding ($M)' = DIVIDE ( MEDIANX ( FILTER ( Companies, NOT ISBLANK ( Companies[Total Funding USD] ) ), Companies[Total Funding USD] ), 1000000 )
		formatString: #,0.00
		lineageTag: d7ec5842-4d42-5681-945f-90235d0a0ebd

	measure 'Active %' = DIVIDE ( CALCULATE ( [Companies], Companies[Operating Status] = "Active" ), [Companies] )
		formatString: 0%
		lineageTag: b4481ad9-3593-526c-99b6-3ff5a80164d3

	measure Countries = DISTINCTCOUNT ( Companies[Country] )
		formatString: #,0
		lineageTag: b313100c-1316-589b-be38-a073ef6333ea

	measure 'Founded 2020+' = CALCULATE ( [Companies], Companies[Founded Year] >= 2020 )
		formatString: #,0
		lineageTag: 95f6f45b-8d8b-503a-85e5-5df2c1791c48

	measure 'Company Name' = SELECTEDVALUE ( Companies[Company], "Several companies" )
		lineageTag: 7bd92ba4-4e37-5b3b-a989-42d8c4d58b02

	measure 'KPI Sub Companies' = VAR top1 = TOPN ( 1, VALUES ( Companies[Sector] ), [Companies], DESC ) RETURN "largest sector: " & MAXX ( top1, Companies[Sector] ) & " (" & FORMAT ( MAXX ( top1, [Companies] ), "#,0" ) & ")"
		lineageTag: e615b6f4-b002-5a79-b6e5-e4dc1eb92edc

	measure 'KPI Sub Funded' = FORMAT ( DIVIDE ( [Funded Companies], [Companies] ), "0%" ) & " have disclosed funding"
		lineageTag: 05bf9871-d380-57fb-993d-3f3165ef0282

	measure 'KPI Sub Total' = "across " & FORMAT ( [Funded Companies] + 0, "#,0" ) & " funded companies"
		lineageTag: d0880e10-d1ec-52ac-a8b4-0053eccc6f68

	measure 'KPI Sub Median' = "per funded company (US$ millions)"
		lineageTag: 06414d94-91c1-5ad8-9d56-6622d7c0fb7a

	measure 'KPI Sub Active' = FORMAT ( CALCULATE ( [Companies], Companies[Operating Status] <> "Active" ) + 0, "#,0" ) & " closed"
		lineageTag: 42d204c0-e817-56ae-8876-d9f657622eae

	measure 'KPI Sub Young' = FORMAT ( DIVIDE ( [Founded 2020+], [Companies] ), "0%" ) & " founded in 2020 or later"
		lineageTag: 649f5083-9c48-5591-b5e6-8898c0c9c0b9

