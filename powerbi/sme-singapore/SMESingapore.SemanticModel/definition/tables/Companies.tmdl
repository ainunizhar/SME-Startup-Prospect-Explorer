table Companies
	lineageTag: 67031b5c-373b-5b1f-bb43-ced6a2997e29

	measure Companies = COUNTROWS ( Companies )
		formatString: #,0
		lineageTag: e730c347-c3e4-51a6-ad3b-d78b1a329092

	measure 'Funded Companies' = CALCULATE ( [Companies], Companies[Has Funding] = "Yes" )
		formatString: #,0
		lineageTag: fb1de62e-245f-5421-aba3-6dd1e012f090

	measure 'Total Funding ($M)' = DIVIDE ( SUM ( Companies[Total Funding USD] ), 1000000 )
		formatString: #,0.0
		lineageTag: 2a920e23-1eee-55c1-b373-4642bbe11cb6

	measure 'Median Funding ($M)' = DIVIDE ( MEDIANX ( FILTER ( Companies, NOT ISBLANK ( Companies[Total Funding USD] ) ), Companies[Total Funding USD] ), 1000000 )
		formatString: #,0.00
		lineageTag: 58daf182-f135-5b0a-bd09-3296e0f454d6

	measure 'Active %' = DIVIDE ( CALCULATE ( [Companies], Companies[Operating Status] = "Active" ), [Companies] )
		formatString: 0%
		lineageTag: 13abab6a-b257-516e-9589-75e0b58c1928

	measure Countries = DISTINCTCOUNT ( Companies[Country] )
		formatString: #,0
		lineageTag: 1e07aa56-51fa-5c73-8af5-dc1298693c98

