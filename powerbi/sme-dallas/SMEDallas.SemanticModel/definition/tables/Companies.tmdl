	column 'Funding Stage Group'
		dataType: string
		lineageTag: b8fa22b2-9ee0-5a48-8c3c-6df0e208a232
		summarizeBy: none
		sourceColumn: Funding Stage Group
		sortByColumn: 'Stage Order'

	column 'Stage Order'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 038beacd-2405-57a6-a5ce-4f45749592b8
		summarizeBy: none
		sourceColumn: Stage Order

	partition Companies = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "sme_dallas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Founded Year", "Employee Range Order", "Revenue Range Order", "Last Funding Date", "Total Funding USD", "Funding Rounds"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Company", type text}, {"Market", type text}, {"Region", type text}, {"Country", type text}, {"Sector", type text}, {"Tier", type text}, {"HQ Location", type text}, {"Description", type text}, {"Industries", type text}, {"Industry Groups", type text}, {"Company Type", type text}, {"Operating Status", type text}, {"Ownership Status", type text}, {"Founded Year", Int64.Type}, {"Employee Range", type text}, {"Employee Range Order", Int64.Type}, {"Revenue Range", type text}, {"Revenue Range Order", Int64.Type}, {"Funding Stage", type text}, {"Last Funding Type", type text}, {"Last Funding Date", type date}, {"Total Funding USD", type number}, {"Funding Rounds", Int64.Type}, {"Has Funding", type text}, {"Website", type text}, {"CB Rank", type text}, {"Acquisition Status", type text}}, "en-US"),

				    Stage = Table.AddColumn(Typed, "Funding Stage Group", each
				        let t = if [Last Funding Type] = null then "" else Text.Lower([Last Funding Type]) in
				        if t = "" then "No round recorded"
				        else if Text.Contains(t, "pre-seed") or Text.Contains(t, "pre seed") then "Pre-seed"
				        else if Text.Contains(t, "seed") or Text.Contains(t, "angel") then "Seed"
				        else if Text.Contains(t, "series a") then "Series A"
				        else if Text.Contains(t, "series b") then "Series B"
				        else if Text.Contains(t, "series c") or Text.Contains(t, "series d") or Text.Contains(t, "series e")
				             or Text.Contains(t, "series f") or Text.Contains(t, "series g") or Text.Contains(t, "series h") then "Series C+"
				        else "Other (grant, debt, PE, ...)", type text),
				    StageOrder = Table.AddColumn(Stage, "Stage Order", each List.PositionOf(
				        {"Pre-seed", "Seed", "Series A", "Series B", "Series C+", "Other (grant, debt, PE, ...)", "No round recorded"},
				        [Funding Stage Group]) + 1, Int64.Type),
				    RevLabel = Table.ReplaceValue(StageOrder, "", "Not disclosed", Replacer.ReplaceValue, {"Revenue Range"}),
				    RevOrder = Table.ReplaceValue(RevLabel, null, 99, Replacer.ReplaceValue, {"Revenue Range Order"})
				in
				    RevOrder

	annotation PBI_ResultType = Table
